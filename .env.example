# このファイルを .env.local に写して値を入れる（.env.local は Git に入れない）。

# ---- ログイン（Auth.js v5） ---------------------------------------------------

# セッション（JWT）を暗号化する鍵。`npx auth secret` か `openssl rand -base64 33` で作る。必須
AUTH_SECRET=

# GitHub OAuth App の Client ID と Client Secret。必須
# コールバック URL は https://<サイトのドメイン>/api/auth/callback/github にする
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Vercel 以外で `next start` するときは 1 にする（リバースプロキシの Host を信じる）
# AUTH_TRUST_HOST=1

# アップロード・削除ができる GitHub のユーザー名。カンマ区切り。大文字小文字は区別しない
ADMIN_GITHUB_LOGINS=nico0748

# ログインしてよい GitHub のユーザー名。カンマ区切り。空なら GitHub アカウントを持つ人は誰でもログインできる
# （ログインした人は全員、一覧とダウンロードができる。管理者は常にログインできる）
ALLOWED_GITHUB_LOGINS=

# 開発用ログイン。1 にすると、ログイン画面に「ユーザー名だけで入る」欄が出る。
# NODE_ENV=production（next build / next start）では、1 にしても無効
# AUTH_DEV_LOGIN=1

# ---- 保存先 -------------------------------------------------------------------

# local: このサーバーの ./.data/shared/ に置く（既定。開発用と、1 台のサーバーで動かすとき用）
# s3:    S3 互換のストレージ（AWS S3・Cloudflare R2 など）に置く。Vercel ではこちらにする
#        （Vercel の関数はリクエスト本文が約 4.5MB までなので、ブラウザから直接ストレージへ送る）
STORAGE_DRIVER=local

# アップロードできる ZIP の上限（MB）。既定は 200
MAX_UPLOAD_MB=200

# ---- STORAGE_DRIVER=s3 のときだけ ----------------------------------------------

# バケット名
S3_BUCKET=
# リージョン。R2 は auto のままでよい
S3_REGION=auto
# S3 互換サービスのエンドポイント。AWS S3 なら空にする
# R2 の例: https://<アカウントID>.r2.cloudflarestorage.com
S3_ENDPOINT=
# アクセスキー（R2 は「R2 API トークン」で作る。対象のバケットの読み書きだけを許す）
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# バケットの CORS に、サイトのオリジンからの PUT（Content-Type ヘッダー付き）を許す設定が要る。
# 手順は docs/zip-format.md の「保存先」を参照
